float sheen_cheb_eval_rough(float x, int offset) {
    float t0 = 1.0;
    float acc = SHEEN_ROUGH_COEFFS[offset];
    float t1 = x;
    acc += SHEEN_ROUGH_COEFFS[offset + 1] * t1;
    for (int n = 2; n <= SHEEN_LUT_DEGREE; n++) {
        float t2 = 2.0 * x * t1 - t0;
        acc += SHEEN_ROUGH_COEFFS[offset + n] * t2;
        t0 = t1;
        t1 = t2;
    }
    return acc;
}

float sheen_cheb_eval_cos(float x, int offset) {
